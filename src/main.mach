use std.runtime;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use page:   std.allocator.page;
use mem:    std.memory;
use time:   std.chrono.time;
use parse:  std.text.parse;
use vec:    std.collections.vector;

use std.print.printf;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.string.str;
use std.types.size.usize;
use std.chrono.duration.Duration;
use std.chrono.duration.duration_msec;

# sieve: mark every prime index below limit in primes.
# ---
# limit: exclusive upper bound (must be >= 2)
# primes: buffer of at least count booleans; primes[i] is true iff i is prime
# count: length of the primes buffer
# ret: an error message when the inputs are invalid, none otherwise
fun sieve(limit: u64, primes: *bool, count: usize) O.Option[str] {
    if (limit < 2) {
        ret O.some[str]("limit must be at least 2");
    }

    if (primes == nil) {
        ret O.some[str]("provided buffer has null data pointer");
    }

    if (count < limit::usize) {
        ret O.some[str]("provided buffer is smaller than required");
    }

    # initialize: assume all are prime
    mem.fill[bool](primes, true, count);
    primes[0] = false;
    primes[1] = false;

    # mark even numbers > 2
    var i: u64 = 4;
    for (i < limit) {
        primes[i::usize] = false;
        i = i + 2;
    }

    # sieve odd composites
    var p: u64 = 3;
    for (p * p < limit) {
        if (primes[p::usize]) {
            var j: u64 = p * p;
            for (j < limit) {
                primes[j::usize] = false;
                j = j + p;
            }
        }
        p = p + 2;
    }

    ret O.none[str]();
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var limit: u64 = 100000000;
    printf("usage: {} [limit] (default: {})\n", argv[0], limit);

    if (argc > 1) {
        val r: R.Result[u64, str] = parse.parse_u64(argv[1], 10);
        if (R.is_err[u64, str](r)) {
            printf("error: invalid limit: {}\n", R.unwrap_err[u64, str](r));
            ret 1;
        }
        limit = R.unwrap_ok[u64, str](r);
    }

    printf("finding primes up to {}\n", limit);

    val count: usize = limit::usize;
    if ((count::u64) != limit) {
        printf("error: limit is too large for this platform\n");
        ret 1;
    }

    # initialize a page-backed allocator
    var a: A.Allocator;
    val opt_make: O.Option[str] = page.make(?a);
    if (O.is_some[str](opt_make)) {
        printf("error: {}\n", O.unwrap[str](opt_make));
        ret 1;
    }

    # allocate memory for the sieve
    val r_alloc: R.Result[*bool, str] = A.allocate[bool](?a, count);
    if (R.is_err[*bool, str](r_alloc)) {
        printf("error: {}\n", R.unwrap_err[*bool, str](r_alloc));
        ret 1;
    }

    val primes: *bool = R.unwrap_ok[*bool, str](r_alloc);

    # run the sieve
    val start:   time.Time     = time.now();
    val opt_err: O.Option[str]   = sieve(limit, primes, count);
    val elapsed: Duration  = time.since(start);

    if (O.is_some[str](opt_err)) {
        printf("error: {}\n", O.unwrap[str](opt_err));
        ret 1;
    }

    # collect prime indices
    var indices: vec.Vector[u64] = vec.init[u64](?a);
    var i: u64 = 0;
    for (i < limit) {
        if (primes[i::usize]) {
            val r_push: R.Result[usize, str] = vec.push[u64](?indices, i);
            if (R.is_err[usize, str](r_push)) {
                printf("error: {}\n", R.unwrap_err[usize, str](r_push));
                ret 1;
            }
        }
        i = i + 1;
    }

    printf("found:       {}\n", indices.len);
    printf("time taken:  {} ms\n", duration_msec(elapsed));

    if (indices.len > 0) {
        printf("first prime: {}\n", indices.data[0]);
        printf("last prime:  {}\n", indices.data[indices.len - 1]);
    }

    # cleanup
    vec.dnit[u64](?indices);
    A.deallocate[bool](?a, primes, count);

    ret 0;
}
